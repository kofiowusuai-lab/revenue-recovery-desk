  { id: 'demo-inv-1018', number: 'INV-1018', amount: 5275, currency: 'USD', daysOverdue: 34, dueDate: '2026-05-19', customerEmail: 'finance@ridgeway-demo.example', customerName: 'Ridgeway Property Group', hostedInvoiceUrl: 'https://pay.example.test/inv-1018', source: 'fake' },
  { id: 'demo-inv-1021', number: 'INV-1021', amount: 920, currency: 'USD', daysOverdue: 4, dueDate: '2026-06-18', customerEmail: null, customerName: 'No Email Demo Account', hostedInvoiceUrl: 'https://pay.example.test/inv-1021', source: 'fake' }
];

async function demoFake(profile) {
  const started = start(profile);
  const audit = [];
  const out = await recover(profile, {
    send: false,
    approved: true,
    atHour: 10,
    limit: 10,
    minDaysOverdue: 1,
    deps: {
      manifest: readJson(path.join(profileDir(profile), 'manifest.json'), {}),
      listInvoices: async () => fakeInvoices,
      executeImpl: async (p, action, opts) => execute(p, action, {
        ...opts,
        deps: {
          auditWrite: (_profile, entry) => audit.push(entry),
          usageBump: () => {},
          capCheck: () => ({ allowed: true, violations: [] })
        }
      })
    }
  });
  const approvalProbe = await execute(profile, {
    channel: 'Email',
    to: { email: 'controller@approval-demo.example', name: 'Approval Demo' },
    subject: 'Approval gate demo',
    text: 'This message intentionally has no approval flag.',
    tool: 'send_via_executor',
    atHour: 10
  }, {
    send: false,
    deps: {
      auditWrite: (_profile, entry) => audit.push(entry),
      usageBump: () => {},
      capCheck: () => ({ allowed: true, violations: [] })
    }
  });
  const payload = {
    mode: 'fake',
    profile,
    sandbox: started.root,
    generatedAt: nowIso(),
    safety: { sent: false, externalApis: false, fakeDataOnly: true },
    recovery: out,
    approvalGateProbe: {
      allowed: approvalProbe.decision?.allowed || false,
      violations: approvalProbe.decision?.violations || []
    },
    audit
  };
  return writeDemo(profile, 'fake', payload);
}

async function fetchJson(url, init = {}) {
  const res = await fetch(url, init);
  const text = await res.text();
  let body; try { body = text ? JSON.parse(text) : null; } catch { body = { raw: text.slice(0, 500) }; }
  if (!res.ok) return { ok: false, status: res.status, error: body?.error?.message || body?.message || body?.error || `HTTP ${res.status}` };
  return { ok: true, status: res.status, body };
}
async function microsoftProbe(token) {
  const headers = { Authorization: `Bearer ${token}` };
  const me = await fetchJson('https://graph.microsoft.com/v1.0/me?$select=displayName,userPrincipalName,mail', { headers });
  const folders = await fetchJson('https://graph.microsoft.com/v1.0/me/mailFolders?$top=5&$select=displayName,totalItemCount,unreadItemCount', { headers });
  return {
    me: me.ok ? { ok: true, displayName: me.body?.displayName || null, userPrincipalName: me.body?.userPrincipalName || null, mail: me.body?.mail || null } : me,
    mailFolders: folders.ok ? { ok: true, folders: (folders.body?.value || []).map((f) => ({ displayName: f.displayName, totalItemCount: f.totalItemCount, unreadItemCount: f.unreadItemCount })) } : folders
  };
}
async function mondayProbe(token) {
  const res = await fetchJson('https://api.monday.com/v2', {
    method: 'POST',
    headers: { Authorization: token, 'Content-Type': 'application/json' },
    body: JSON.stringify({ query: 'query { me { id name email } account { id name } }' })
  });
  if (!res.ok) return res;
  if (res.body?.errors) return { ok: false, status: 200, error: res.body.errors.map((e) => e.message).join('; ') };
  return { ok: true, me: res.body?.data?.me || null, account: res.body?.data?.account || null };
}
async function hubspotProbe(token) {
  const res = await fetchJson('https://api.hubapi.com/crm/v3/objects/deals?limit=3&properties=dealname,amount,closedate', { headers: { Authorization: `Bearer ${token}` } });
  if (!res.ok) return res;
  return { ok: true, deals: (res.body?.results || []).map((d) => ({ id: d.id, properties: d.properties })) };
}

async function demoLiveReadonly(profile) {
  const started = start(profile);
  const env = readEnvKeys(profile);
  const connectors = {};
  if (env.vals.MICROSOFT_ACCESS_TOKEN) connectors.microsoft = await microsoftProbe(env.vals.MICROSOFT_ACCESS_TOKEN);
  if (env.vals.MONDAY_ACCESS_TOKEN) connectors.monday = await mondayProbe(env.vals.MONDAY_ACCESS_TOKEN);
  if (env.vals.HUBSPOT_ACCESS_TOKEN) connectors.hubspot = await hubspotProbe(env.vals.HUBSPOT_ACCESS_TOKEN);
  const gate = await execute(profile, {
    channel: 'Email',
    to: { email: 'readonly-demo@example.test', name: 'Read Only Demo' },
    subject: 'Read-only demo gate',
    text: 'This is a gate-only dry-run. Nothing is sent.',
    tool: 'send_via_executor',
    approved: true,
    atHour: 10
  }, {
    send: false,
    deps: { auditWrite: () => {}, usageBump: () => {}, capCheck: () => ({ allowed: true, violations: [] }) }
  });
  const payload = {
    mode: 'live-readonly',
    profile,
    sandbox: started.root,
    generatedAt: nowIso(),
    safety: { sent: false, externalApis: true, readonly: true, tokenValuesPrinted: false },
    installedKeyNames: env.present.filter((k) => /_TOKEN$|_TOKEN_EXPIRES_AT$|_INSTANCE_URL$|_API_DOMAIN$|_REALM_ID$/.test(k)),
    connectorProbes: connectors,
    gateOnlyProbe: { wouldSend: !!gate.wouldSend, allowed: !!gate.decision?.allowed, violations: gate.decision?.violations || [] }
  };
  return writeDemo(profile, 'live-readonly', payload);
}

function writeDemo(profile, mode, payload) {
  const file = path.join(outDir(profile), `${stamp()}-${mode}.json`);
  writeJson(file, payload);
  const summaryPath = path.join(outDir(profile), `${stamp()}-${mode}.md`);
  fs.writeFileSync(summaryPath, renderSummary(payload) + '\n');
  updateState(profile, 'stopped', { lastRunAt: nowIso(), lastMode: mode, latestOutput: file, latestSummary: summaryPath });
  return { ...payload, outputFile: file, summaryFile: summaryPath };
}
function renderSummary(p) {
  const L = [];
  L.push(`# RRD Local Sandbox Demo — ${p.profile}`);
  L.push(`Mode: ${p.mode}`);
  L.push(`Generated: ${p.generatedAt}`);
  L.push(`Sandbox: ${p.sandbox}`);
  L.push('');
  L.push('## Safety');
  for (const [k, v] of Object.entries(p.safety || {})) L.push(`- ${k}: ${v}`);
  if (p.mode === 'fake') {
    L.push(''); L.push('## Recovery dry-run');
    L.push(`- Overdue invoices found: ${p.recovery?.found}`);
    L.push(`- Outcomes: ${JSON.stringify(p.recovery?.summary?.byOutcome || {})}`);
    L.push(`- Amount targeted: ${p.recovery?.summary?.targetedUsd}`);
    L.push(`- Approval probe allowed: ${p.approvalGateProbe?.allowed}`);
    L.push(`- Approval probe violations: ${(p.approvalGateProbe?.violations || []).map((v) => v.code).join(', ') || 'none'}`);
    for (const r of p.recovery?.results || []) L.push(`- ${r.outcome}: ${r.number || r.invoiceId} -> ${r.email || 'no email'} (${r.amountUsd})`);
  } else {
    L.push(''); L.push('## Installed token key names');
    for (const k of p.installedKeyNames || []) L.push(`- ${k}`);
    L.push(''); L.push('## Connector probes');
    for (const [name, val] of Object.entries(p.connectorProbes || {})) L.push(`- ${name}: ${val.ok === false ? 'failed: ' + val.error : 'ok'}`);
    L.push(`- gateOnlyProbe: allowed=${p.gateOnlyProbe?.allowed}, wouldSend=${p.gateOnlyProbe?.wouldSend}`);
  }
  return L.join('\n');
}

function printResult(obj) { console.log(JSON.stringify(obj, null, 2)); }
async function main() {
  const [, , cmd, profile, ...args] = process.argv;
  if (!cmd || cmd === 'help' || cmd === '-h' || cmd === '--help') usage(cmd ? 0 : 1);
  let res;
  if (cmd === 'list') res = list();
  else if (cmd === 'provision') res = provision(profile);
  else if (cmd === 'start') res = start(profile);
  else if (cmd === 'stop') res = stop(profile);
  else if (cmd === 'status') res = status(profile);
  else if (cmd === 'destroy') res = destroy(profile);
  else if (cmd === 'demo') {
    if (args.includes('--fake')) res = await demoFake(profile);
    else if (args.includes('--live-readonly')) res = await demoLiveReadonly(profile);
    else throw new Error('demo requires --fake or --live-readonly');
  } else if (cmd === 'run') {
    throw new Error('run is reserved for the Hermes task runner; use demo --fake or demo --live-readonly for now');
  } else usage();
  printResult(res);
}

if (import.meta.url === `file://${SELF}`) main().catch((e) => { console.error('Error: ' + (e?.message || e)); process.exit(1); });

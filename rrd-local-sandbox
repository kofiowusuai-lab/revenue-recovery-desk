#!/usr/bin/env node
/**
 * rrd-local-sandbox — local Orgo-equivalent demo harness for Revenue Recovery Desk.
 *
 * Mirrors the Orgo operating model without a paid cloud desktop:
 *   provision/start/status/run/stop/destroy/demo <profile>
 *
 * Each profile gets an isolated local directory under:
 *   /Users/AIAgenterminal/.openclaw/local-sandboxes/<profile>/
 *
 * Demo modes:
 *   rrd-local-sandbox demo rr-test --fake
 *   rrd-local-sandbox demo rr-test --live-readonly
 *
 * Safety:
 * - never sends customer outreach;
 * - never prints token values;
 * - live-readonly only calls read endpoints for installed connectors;
 * - audit/output is written into the sandbox for client walkthroughs.
 */
import fs from 'node:fs';
import path from 'node:path';
import os from 'node:os';
import { fileURLToPath } from 'node:url';
import { recover } from './rrd-collect.mjs';
import { execute } from './rrd-recover.mjs';

const OPERATOR_HOME = process.env.RRD_OPERATOR_HOME || '/Users/AIAgenterminal';
const ROOT = process.env.RRD_LOCAL_SANDBOX_ROOT || path.join(OPERATOR_HOME, '.openclaw', 'local-sandboxes');
const PROFILES_DIR = process.env.HERMES_PROFILES_DIR || path.join(OPERATOR_HOME, '.hermes', 'profiles');
const SELF = fileURLToPath(import.meta.url);

function usage(exit = 1) {
  console.error(`rrd-local-sandbox — local Orgo-equivalent demo harness

Usage:
  rrd-local-sandbox provision <profile>
  rrd-local-sandbox start <profile>
  rrd-local-sandbox stop <profile>
  rrd-local-sandbox status <profile>
  rrd-local-sandbox list
  rrd-local-sandbox destroy <profile>
  rrd-local-sandbox demo <profile> --fake
  rrd-local-sandbox demo <profile> --live-readonly

Notes:
  --fake          deterministic fake invoice/demo data; no external APIs
  --live-readonly reads installed connector metadata only; no sends, no writes`);
  process.exit(exit);
}

function nowIso() { return new Date().toISOString(); }
function stamp() { return new Date().toISOString().replace(/[:.]/g, '-'); }
function profileDir(profile) { return path.join(PROFILES_DIR, profile); }
function sbDir(profile) { return path.join(ROOT, profile); }
function metaPath(profile) { return path.join(sbDir(profile), 'sandbox.json'); }
function auditDir(profile) { return path.join(sbDir(profile), 'audit'); }
function outDir(profile) { return path.join(sbDir(profile), 'outputs'); }
function workspaceDir(profile) { return path.join(sbDir(profile), 'workspace'); }
function tmpDir(profile) { return path.join(sbDir(profile), 'tmp'); }

function readJson(file, fallback = null) {
  try { return JSON.parse(fs.readFileSync(file, 'utf8')); } catch { return fallback; }
}
function writeJson(file, obj) {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(file, JSON.stringify(obj, null, 2) + '\n');
}
function ensureProfile(profile) {
  if (!profile) usage();
  const dir = profileDir(profile);
  if (!fs.existsSync(dir)) throw new Error(`Profile not found: ${profile} (${dir})`);
}
function provision(profile) {
  ensureProfile(profile);
  for (const d of [sbDir(profile), workspaceDir(profile), path.join(sbDir(profile), 'downloads'), auditDir(profile), outDir(profile), tmpDir(profile), path.join(sbDir(profile), 'browser-profile')]) {
    fs.mkdirSync(d, { recursive: true });
  }
  const manifest = readJson(path.join(profileDir(profile), 'manifest.json'), {});
  const meta = {
    profile,
    company: manifest.company || profile.replace(/^rr-/, ''),
    createdAt: fs.existsSync(metaPath(profile)) ? (readJson(metaPath(profile), {})?.createdAt || nowIso()) : nowIso(),
    updatedAt: nowIso(),
    state: 'provisioned',
    root: sbDir(profile),
    workspace: workspaceDir(profile),
    audit: auditDir(profile),
    browserProfile: path.join(sbDir(profile), 'browser-profile'),
    model: 'local-orgo-equivalent-demo',
    productionEquivalent: 'Orgo project + desktop per client; this local sandbox mirrors the run lifecycle on this Mac',
    secretsPolicy: 'profile .env stays in Hermes profile; demo outputs list key names only, never values'
  };
  writeJson(metaPath(profile), meta);
  return meta;
}
function updateState(profile, state, extra = {}) {
  const cur = fs.existsSync(metaPath(profile)) ? readJson(metaPath(profile), {}) : provision(profile);
  const next = { ...cur, ...extra, state, updatedAt: nowIso() };
  writeJson(metaPath(profile), next);
  return next;
}
function start(profile) { ensureProfile(profile); provision(profile); return updateState(profile, 'running', { startedAt: nowIso() }); }
function stop(profile) {
  ensureProfile(profile);
  fs.rmSync(tmpDir(profile), { recursive: true, force: true });
  fs.mkdirSync(tmpDir(profile), { recursive: true });
  return updateState(profile, 'stopped', { stoppedAt: nowIso(), tmpWiped: true });
}
function destroy(profile) {
  ensureProfile(profile);
  fs.rmSync(sbDir(profile), { recursive: true, force: true });
  return { profile, destroyed: true, root: sbDir(profile) };
}
function status(profile) {
  ensureProfile(profile);
  if (!fs.existsSync(metaPath(profile))) provision(profile);
  const meta = readJson(metaPath(profile), {});
  const files = fs.existsSync(outDir(profile)) ? fs.readdirSync(outDir(profile)).sort() : [];
  return { ...meta, outputCount: files.length, latestOutput: files.at(-1) || null };
}
function list() {
  fs.mkdirSync(ROOT, { recursive: true });
  return fs.readdirSync(ROOT).filter((n) => fs.existsSync(metaPath(n))).map((n) => status(n));
}

function readEnvKeys(profile) {
  const envPath = path.join(profileDir(profile), '.env');
  const text = fs.existsSync(envPath) ? fs.readFileSync(envPath, 'utf8') : '';
  const keys = [];
  const present = new Set();
  const vals = {};
  for (const line of text.split(/\r?\n/)) {
    if (!line || line.trim().startsWith('#') || !line.includes('=')) continue;
    const i = line.indexOf('=');
    const k = line.slice(0, i).trim();
    const v = line.slice(i + 1).trim().replace(/^['"]|['"]$/g, '');
    if (k) keys.push(k);
    if (v && !/^CHANGE_ME|TODO|PLACEHOLDER|xxx/i.test(v)) { present.add(k); vals[k] = v; }
  }
  return { envPath, keys: [...new Set(keys)].sort(), present: [...present].sort(), vals };
}


#!/Users/AIAgenterminal/.hermes/hermes-agent/venv/bin/python
"""RRD Composio bridge helper.

Uses COMPOSIO_API_KEY from /Users/AIAgenterminal/.openclaw/.env and never prints
secret values. Designed for connector spikes/fallbacks such as Pipedrive.
"""
from __future__ import annotations
import json, os, re, sys
from pathlib import Path

ENV_PATH = Path('/Users/AIAgenterminal/.openclaw/.env')
DEFAULT_PIPEDRIVE_VERSION = os.environ.get('COMPOSIO_PIPEDRIVE_TOOLKIT_VERSION', '20260616_00')
DEFAULT_USER_ID = os.environ.get('COMPOSIO_PIPEDRIVE_USER_ID', 'rrd-pipedrive-test-2')


def load_env():
    if not ENV_PATH.exists():
        return
    for line in ENV_PATH.read_text().splitlines():
        m = re.match(r'^([A-Z0-9_]+)=(.*)$', line)
        if not m:
            continue
        v = m.group(2).strip()
        try:
            if (v.startswith('"') and v.endswith('"')) or (v.startswith("'") and v.endswith("'")):
                v = json.loads(v)
        except Exception:
            pass
        os.environ.setdefault(m.group(1), v)


def client():
    load_env()
    if not os.environ.get('COMPOSIO_API_KEY'):
        raise SystemExit('COMPOSIO_API_KEY missing from /Users/AIAgenterminal/.openclaw/.env')
    from composio import Composio
    return Composio(api_key=os.environ['COMPOSIO_API_KEY'])


def compact_result(res):
    d = res.model_dump() if hasattr(res, 'model_dump') else res
    if not isinstance(d, dict):
        return {'raw_type': type(res).__name__}
    data = d.get('data')
    out = {'successful': d.get('successful')}
    if isinstance(data, dict):
        out['success'] = data.get('success')
        inner = data.get('data')
        pagination = (data.get('additional_data') or {}).get('pagination')
        if pagination:
            out['pagination'] = pagination
        if isinstance(inner, list):
            out['rows_returned'] = len(inner)
            out['sample'] = [
                {k: row.get(k) for k in ['id','title','name','status','value','currency','org_name','person_name','key','field_type'] if isinstance(row, dict) and k in row}
                for row in inner[:3]
            ]
        elif inner is None:
            out['rows_returned'] = 0
        elif isinstance(inner, dict):
            out['inner_keys'] = list(inner.keys())[:20]
    if d.get('error'):
        out['error'] = str(d['error'])[:500]
    return out


def cmd_status(args):
    c = client()
    ca = os.environ.get('COMPOSIO_PIPEDRIVE_TEST_CONNECTED_ACCOUNT_ID')
    if not ca:
        raise SystemExit('COMPOSIO_PIPEDRIVE_TEST_CONNECTED_ACCOUNT_ID missing')
    acc = c.connected_accounts.get(ca)
    print(json.dumps({
        'connected_account_id': ca,
        'status': getattr(acc, 'status', None),
        'toolkit': getattr(getattr(acc, 'toolkit', None), 'slug', None),
        'user_id': getattr(acc, 'user_id', None),
    }, indent=2))


def cmd_pipedrive_smoke(args):
    c = client()
    ca = os.environ.get('COMPOSIO_PIPEDRIVE_TEST_CONNECTED_ACCOUNT_ID')
    if not ca:
        raise SystemExit('COMPOSIO_PIPEDRIVE_TEST_CONNECTED_ACCOUNT_ID missing')
    checks = [
        ('PIPEDRIVE_GET_ALL_DEALS', {'limit': 3, 'status': 'all_not_deleted'}),
        ('PIPEDRIVE_GET_ALL_PERSONS', {'limit': 3}),
        ('PIPEDRIVE_GET_ALL_ORGANIZATIONS', {'limit': 3}),
        ('PIPEDRIVE_GET_ALL_DEAL_FIELDS', {'limit': 10}),
    ]
    summary = []
    for slug, arguments in checks:
        try:
            res = c.tools.execute(slug, arguments, connected_account_id=ca, user_id=DEFAULT_USER_ID, version=DEFAULT_PIPEDRIVE_VERSION)
            item = compact_result(res)
            item['slug'] = slug
        except Exception as e:
            item = {'slug': slug, 'successful': False, 'error': str(e)[:500]}
        summary.append(item)
    print(json.dumps(summary, indent=2))


def cmd_tools(args):
    if len(args) < 1:
        raise SystemExit('usage: rrd-composio tools <toolkit> [search]')
    c = client()
    toolkit = args[0]
    search = args[1] if len(args) > 1 else None
    tools = c.tools.get(user_id=DEFAULT_USER_ID, toolkits=[toolkit.upper()], search=search, limit=25)
    out = []
    for t in tools[:25]:
        fn = t.get('function', {}) if isinstance(t, dict) else {}
        out.append({'name': fn.get('name'), 'description': (fn.get('description') or '')[:180]})
    print(json.dumps(out, indent=2))


def cmd_execute(args):
    if len(args) < 2:
        raise SystemExit("usage: rrd-composio execute <tool_slug> '<json-args>' [connected_account_id]")
    c = client()
    slug = args[0]
    arguments = json.loads(args[1])
    ca = args[2] if len(args) > 2 else os.environ.get('COMPOSIO_PIPEDRIVE_TEST_CONNECTED_ACCOUNT_ID')
    version = DEFAULT_PIPEDRIVE_VERSION if slug.startswith('PIPEDRIVE_') else None
    kwargs = {'connected_account_id': ca, 'user_id': DEFAULT_USER_ID}
    if version:
        kwargs['version'] = version
    res = c.tools.execute(slug, arguments, **kwargs)
    print(json.dumps(compact_result(res), indent=2))


def usage():
    print('''rrd-composio

Commands:
  status                         Show Pipedrive Composio connection status
  pipedrive-smoke                Run safe read-only Pipedrive smoke checks
  tools <toolkit> [search]       List Composio tools for a toolkit/search
  execute <slug> '<json>' [ca]   Execute a tool and print compact result
''')


def main(argv):
    if not argv or argv[0] in ('-h','--help','help'):
        usage(); return 0
    cmd, args = argv[0], argv[1:]
    if cmd == 'status': cmd_status(args)
    elif cmd == 'pipedrive-smoke': cmd_pipedrive_smoke(args)
    elif cmd == 'tools': cmd_tools(args)
    elif cmd == 'execute': cmd_execute(args)
    else:
        raise SystemExit(f'unknown command: {cmd}')
    return 0

if __name__ == '__main__':
    raise SystemExit(main(sys.argv[1:]))
